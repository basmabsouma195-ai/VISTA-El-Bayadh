      "type": "symbol",
      "source": "el-bayadh",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["any", ["has", "name"], ["has", "name:ar"], ["has", "name:fr"], ["has", "name:en"]],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          ["get", "name:ar"],
          ["get", "name:fr"],
          ["get", "name:en"],
          ["get", "name:latin"],
          ["get", "name"]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#59636A",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.2
