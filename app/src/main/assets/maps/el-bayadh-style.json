          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.35,
          12,
          1.7,
          14,
          3
        ]
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "el-bayadh",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary",
        "secondary",
        "tertiary"
